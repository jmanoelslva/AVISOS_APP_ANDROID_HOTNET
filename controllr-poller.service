[Unit]
Description=Controllr Poller - HOTNET (pagamento, atraso, lembrete de vencimento e chamado via FCM)
After=network.target

[Service]
Type=oneshot
User=aviso-broadcaster
WorkingDirectory=/opt/aviso-broadcaster
Environment="PATH=/opt/aviso-broadcaster/venv/bin"
ExecStart=/opt/aviso-broadcaster/venv/bin/python poller.py
